{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mediclin",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "build": {
    "command": "npm run build",
    "cwd": "./",
    "upload_dir": ".output/public"
  }
}
