# ═══════════════════════════════════════════════════════════════════════════════
# CuidandoVC — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database (Neon Postgres) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/database

# ── Clerk Authentication ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_... # from Clerk dashboard webhooks

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_...
MERCADOPAGO_APP_ID=your_app_id
MERCADOPAGO_APP_SECRET=your_app_secret
MP_PLAN_ID_PRO=your_pro_plan_id # R$79/mês
MP_PLAN_ID_CLINIC=your_clinic_plan_id # R$199/mês

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── WhatsApp (Twilio) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886 # optional, defaults to sandbox

# ── App Configuration ──────────────────────────────────────────────────────────
APP_DOMAIN=mediclin.app # production domain (or localhost for local dev)
CRON_SECRET=auto-generated by Vercel # for cron job protection

# ── Stripe (deprecated, use Mercado Pago) ──────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
